# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter key from openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — the main model (default deepseek/deepseek-v4.1-flash-1017). Bot 2 uses z-ai/glm-5.3-flash.
# Each model always runs on its own fixed provider from config.json (model_providers), with no fallbacks:
# deepseek/deepseek-v4.1-flash-1017 → deepinfra/fp8 · z-ai/glm-5.3-flash → relace/fp4
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional — the Coding mode agents (default z-ai/glm-5.3-flash). The lead is OPENROUTER_MODEL.
AGENT_MODEL=z-ai/glm-5.3-flash

# Your Telegram user id (get it from @userinfobot) — only you can change the persona, use Coding mode and GitHub
OWNER_ID=

# Optional — a GitHub token (github.com/settings/tokens) so the bot can write, edit, create and watch CI on your repos.
# Owner only. Without it the bot works normally, just without GitHub access.
# Scopes: repo + workflow (classic), or Contents/Pull requests/Issues/Actions read & write (fine-grained).
GH_PAT=

# Optional — the key that encrypts the persona and lock rules so nobody else can read them (not even repo readers).
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PERSONA_KEY=

# How many messages the bot remembers per chat (10 per side)
MAX_HISTORY=20
