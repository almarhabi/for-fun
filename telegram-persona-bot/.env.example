# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# مفتاح OpenRouter من openrouter.ai/keys
OPENROUTER_API_KEY=

# اختياري — الافتراضي: moonshotai/kimi-k3.1-pro عبر المزودين relace/fp4 و inference-net/mxfp4/us
OPENROUTER_MODEL=moonshotai/kimi-k3.1-pro
OPENROUTER_PROVIDER=relace/fp4,inference-net/mxfp4/us

# رقمك في تليجرام (اعرفه من @userinfobot) — أنت فقط تقدر تغيّر الهوية وتستخدم أدوات GitHub
OWNER_ID=

# اختياري — توكن GitHub (github.com/settings/tokens) عشان البوت يكتب ويعدّل وينشئ على مستودعاتك.
# للمالك فقط. بدونه البوت يشتغل عادي بس بدون صلاحيات GitHub.
GH_PAT=

# اختياري — مفتاح تشفير الهوية وقواعد القفل عشان ما يشوفها أحد غيرك (ولا حتى من عنده المستودع).
# ولّد مفتاح: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PERSONA_KEY=

# عدد الرسائل اللي يتذكرها البوت في كل محادثة (10 لكل طرف)
MAX_HISTORY=20
