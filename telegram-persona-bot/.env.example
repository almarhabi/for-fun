# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# مفتاح OpenRouter من openrouter.ai/keys
OPENROUTER_API_KEY=

# اختياري — الافتراضي: moonshotai/kimi-k3.1-pro عبر المزود relace/fp4 بدون بديل
OPENROUTER_MODEL=moonshotai/kimi-k3.1-pro
OPENROUTER_PROVIDER=relace/fp4

# رقمك في تليجرام (اعرفه من @userinfobot) — أنت فقط تقدر تغيّر الهوية
OWNER_ID=

# عدد الرسائل اللي يتذكرها البوت في كل محادثة
MAX_HISTORY=20
